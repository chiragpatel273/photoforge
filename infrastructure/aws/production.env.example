# Store the completed file as the SecretString of a Secrets Manager secret.
# Copy to an ignored .env file outside the repository, with file permissions 600.
# Do not use the local-development .env on AWS.
NODE_ENV=production
PORT=4000
DOMAIN=photos.example.com
WEB_ORIGIN=https://photos.example.com
API_INTERNAL_URL=http://api:4000
DATABASE_URL=postgresql://photoforge_app:URL_ENCODED_PASSWORD@RDS_HOST:5432/photoforge?sslmode=require
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
S3_REGION=us-east-1
S3_BUCKET=replace-with-a-globally-unique-photoforge-bucket
S3_FORCE_PATH_STYLE=false
# Production Compose sets REDIS_URL to its private Redis container.
# Omit S3_ENDPOINT, S3_PUBLIC_ENDPOINT, S3_ACCESS_KEY and S3_SECRET_KEY.
# The AWS SDK uses the EC2 instance role.
