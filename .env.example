# Copy to .env. Replace every CHANGE_ME value (at least 32 random characters).
NODE_ENV=development
DATABASE_URL=postgresql://photoforge:CHANGE_ME_DATABASE_PASSWORD@localhost:5432/photoforge
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
REDIS_URL=redis://localhost:6379
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000
PORT=4000
S3_BUCKET=photoforge
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=photoforge
S3_SECRET_KEY=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
S3_FORCE_PATH_STYLE=true
